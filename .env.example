# Copy to .env and fill in. Never commit .env.
# LLM (P4+). Model IDs live in backend/configs/, not here.
GROQ_API_KEY=
LLM_PROVIDER=groq            # groq | ollama
OLLAMA_BASE_URL=http://localhost:11434

# Vector DB (P2+)
QDRANT_URL=http://localhost:6333

# Tracing (P5)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Experiments (P3)
MLFLOW_TRACKING_URI=file:./mlruns

# Kaggle (CI only; locally use %USERPROFILE%\.kaggle\kaggle.json, see PLAN.md §0.2)
KAGGLE_USERNAME=
KAGGLE_KEY=

# Hugging Face cache (optional)
HF_HOME=
